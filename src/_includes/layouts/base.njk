<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ renderData.title or title or metadata.title }}</title>
    <meta name="Description" content="{{ renderData.description or description or metadata.description }}">
    <link rel="alternate" href="{{ metadata.feed.path | url }}" type="application/atom+xml" title="{{ metadata.title }}">

    <!-- avoids a white flash before the inline stylesheet below runs -->
    <style>html{background:#0b0a08;}</style>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <!-- code block style -->
    <link href="https://unpkg.com/prismjs@1.20.0/themes/prism-okaidia.css" rel="stylesheet"/>

    <script defer src="https://kit.fontawesome.com/1b01ea6d0e.js" crossorigin="anonymous"></script>

  </head>
  <body>
    <!-- capture the CSS content as a Nunjucks variable -->
    {% set css %}
      {% include '_site/css/index.css' %}
    {% endset %}
    <!-- feed it through our cssmin filter to minify -->
    <style>
      {{ css | cssmin | safe }}
    </style>

    <header>
      <div class="term-titlebar">
        <span class="site-path">~/adventures-in-coding</span>
        <!-- Easy to delete this line if you don't want it public -->
        <span class="status">open to staff / principal roles &middot; remote</span>
      </div>
      <div class="term-row">
        <a class="prompt-home" href="{{ '/' | url }}">
          <span class="seg-user">corey</span><span class="seg-dollar">@</span><span class="seg-host">mccarty.dev</span><span class="seg-dollar">:~$</span> <span class="cursor">_</span>
        </a>
        <ul class="nav">
          {%- for nav in collections.nav | reverse -%}
          <li class="nav-item{% if nav.url == page.url %} nav-item-active{% endif %}"><a href="{{ nav.url | url }}">{{ nav.data.navtitle | lower }}</a></li>
          {%- endfor -%}
        </ul>
        <span class='contact'>
          <a aria-label="linkedin" href="https://linkedin.mccarty.dev"><i class="fab fa-linkedin"></i></a>
          <a aria-label="dev dot to" href="https://devto.mccarty.dev"><i class="fab fa-dev"></i></a>
          <a aria-label="github" href="https://github.mccarty.dev"><i class="fab fa-github"></i></a>
          <a aria-label="email" href="mailto:Corey@McCarty.dev"><i class="fas fa-envelope"></i></a>
          <a aria-label="phone number" href="tel:‪(901) 832-7968‬"><i class="fas fa-phone"></i>‬</a>
        </span>
      </div>
    </header>

    <main{% if templateClass %} class="{{ templateClass }}"{% endif %}>
      {{ content | safe }}
    </main>

    <footer>
      <p class="prompt-line"><span class="seg-user">corey</span>@<span class="seg-host">mccarty.dev</span>:~$ echo &quot;thanks for reading&quot;</p>
      <p>&copy; {% year %} Corey McCarty &middot; Built with <a href="https://11ty.io">Eleventy</a></p>
    </footer>

    <!-- Types out the [data-typewriter] line on the homepage; skipped
         entirely if the visitor prefers reduced motion. -->
    <script>
      (function () {
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var el = document.querySelector('[data-typewriter]');
        if (!el) return;
        var full = el.textContent;
        el.textContent = '';
        var i = 0;
        (function tick() {
          el.textContent = full.slice(0, i);
          i++;
          if (i <= full.length) {
            setTimeout(tick, 18);
          }
        })();
      })();
    </script>

    <!-- Current page: {{ page.url | url }} -->
  </body>
</html>
